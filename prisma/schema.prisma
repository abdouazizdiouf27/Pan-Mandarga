// PAN Mandarga — Prisma schema (MySQL / Hostinger)
// E-commerce premium, mode sénégalaise

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH — Admin users (JWT strategy, no session table needed)
// ============================================================
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String
  role          String   @default("ADMIN") // ADMIN | EDITOR
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ============================================================
// CATALOG
// ============================================================
model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  parentId    String?
  parent      Category? @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryParent")
  products    Product[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Collection {
  id          String              @id @default(cuid())
  name        String
  slug        String              @unique
  description String?
  image       String?
  published   Boolean             @default(true)
  products    ProductCollection[]
  promotions  PromotionCollection[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

// M:N join table Product <-> Collection
model ProductCollection {
  id           String     @id @default(cuid())
  productId    String
  collectionId String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([productId, collectionId])
}

model Product {
  id                        String              @id @default(cuid())
  name                      String
  slug                      String              @unique
  code                      String              @unique
  description               String
  price                     Int
  compareAtPrice            Int?
  costPrice                 Int?
  status                    String              @default("draft") // draft | published | archived
  availability              String              @default("made_to_order") // in_stock | made_to_order | custom | out_of_stock
  stock                     Int                 @default(0)
  isFeatured                Boolean             @default(false)
  isNew                     Boolean             @default(false)
  featuredUntil             DateTime?
  publishedAt               DateTime?
  categoryId                String?
  category                  Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  collections               ProductCollection[]
  tags                      String              @default("[]") // JSON stringified array
  material                  String?
  colors                    String? // JSON stringified array
  sizes                     String? // JSON stringified array
  customizationEnabled      Boolean             @default(false)
  customizationFee          Int                 @default(0)
  customizationInstructions String?
  videoUrl                  String?
  seoTitle                  String?
  seoDescription           String?
  ogImage                   String?
  canonicalUrl              String?
  source                    String?
  confidence                String?
  mainImageId               String?
  variants                  ProductVariant[]
  images                    Media[]
  orderItems                OrderItem[]
  promotions                PromotionProduct[]
  createdAt                 DateTime            @default(now())
  updatedAt                 DateTime            @updatedAt
}

model ProductVariant {
  id                  String   @id @default(cuid())
  productId           String
  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name                String
  sku                 String?
  price               Int?
  stock               Int?
  size                String?
  color               String?
  customizationOption String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Media {
  id        String   @id @default(cuid())
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String   @default("")
  type      String   @default("image") // image | video
  position  Int      @default(0)
  isMain    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Promotion {
  id         String   @id @default(cuid())
  name       String
  type       String   // percentage | fixed | price_override
  value      Int
  targetType String   // product | variant | collection
  targetId   String?
  startsAt   DateTime?
  endsAt     DateTime?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // === Ciblage précis M:N (tables de liaison) ===
  // Un montant fixe ou un pourcentage s'applique individuellement à chaque
  // produit/collection listé ici. targetId (legacy) reste pour compat.
  products    PromotionProduct[]
  collections PromotionCollection[]
}

// Promotion <-> Product (sélection multiple de produits)
model PromotionProduct {
  id          String @id @default(cuid())
  promotionId String
  productId   String
  createdAt   DateTime @default(now())

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([promotionId, productId])
  @@index([promotionId])
  @@index([productId])
}

// Promotion <-> Collection (sélection multiple de collections)
model PromotionCollection {
  id           String @id @default(cuid())
  promotionId  String
  collectionId String
  createdAt    DateTime @default(now())

  promotion  Promotion  @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([promotionId, collectionId])
  @@index([promotionId])
  @@index([collectionId])
}

// ============================================================
// COMMERCE
// ============================================================
model Customer {
  id             String   @id @default(cuid())
  name           String?
  phone          String?
  email          String?
  city           String?
  address        String?
  whatsappConsent Boolean @default(true)
  orders         Order[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  customerId     String?
  customer       Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName   String
  customerPhone  String
  customerEmail  String?
  customerCity   String?
  customerAddress String?
  channel        String      @default("WEB") // WEB | WHATSAPP | ADMIN
  status         String      @default("new") // new | to_confirm | confirmed | preparing | ready | shipped | delivered | cancelled
  subtotal       Int
  discount       Int         @default(0)
  shipping       Int         @default(0)
  total          Int
  currency       String      @default("FCFA")
  itemsJson      String
  notes          String?
  // === Signal de hauteur (prompt v3 — Partie 1) ===
  // AUCUNE hauteur exacte stockée (prompt §14, §27) — uniquement le signal.
  // Type : "BELOW_175" (< 175 cm) | "ABOVE_195" (> 195 cm) | null (pas de signal)
  heightWarningType String?
  // true si le client a explicitement cliqué sur un bouton de signalement
  heightWarningConfirmed Boolean @default(false)
  orderItems     OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model OrderItem {
  id                 String   @id @default(cuid())
  orderId            String
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId          String?
  product            Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productSnapshot    String
  variantSnapshot    String?
  size               String?
  color              String?
  quantity           Int
  unitPrice          Int
  customization      Boolean  @default(false)
  customizationFee   Int      @default(0)
  lineTotal          Int
  createdAt          DateTime @default(now())
}

// ============================================================
// SETTINGS — singleton key/value store
// ============================================================
model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// ============================================================
// CONTENT — editable page content (About, etc.)
// ============================================================
model Content {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  body      String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ============================================================
// ANALYTICS — fréquentation agrégée du site (visiteurs anonymes)
// Pas de données personnelles : ni nom, ni email, ni téléphone.
// Un visiteur est identifié par un visitorId opaque (cookie anonyme).
// ============================================================

model AnalyticsEvent {
  id         String   @id @default(cuid())
  // Type d'événement : page_view | product_view | collection_view
  type       String
  // Cible : slug produit, slug collection, ou chemin de page pour page_view
  path       String
  // Nom humain résolu à l'enregistrement (ex: "BIDEW" pour /products/bidew)
  // Évite de devoir rejoindre Product/Collection à chaque requête analytique.
  label      String?
  // visitorId opaque (cookie HTTP-only, randomUUID, pas de lien avec compte)
  visitorId  String
  // Session HTTP — agrège les visites d'un même visiteur sur ~30 min
  sessionId  String
  // Référent (referer header, tronqué au host) — pour connaître la source
  referrer   String?
  // User-Agent hashé (SHA-256, pas de stockage brut) — pour device stats agrégées
  uaHash     String?
  // Pays/région devinée via headers (optionnel, pas d'IP stockée)
  country    String?
  createdAt  DateTime @default(now())

  @@index([type, createdAt])
  @@index([visitorId, createdAt])
  @@index([path, createdAt])
  @@index([createdAt])
}

// Snapshot quotidien agrégé pour requêtes rapides du dashboard.
// Régénéré par un script cron (ou à la demande) à partir de AnalyticsEvent.
model AnalyticsDaily {
  id         String   @id @default(cuid())
  // Date (YYYY-MM-DD, jour calendaire UTC)
  date       DateTime
  // type + path identiques à AnalyticsEvent ; label pour affichage direct
  type       String
  path       String
  label      String?
  // visiteurs uniques ce jour-là pour ce type+path
  visitors   Int      @default(0)
  // nombre total de vues (peut > visitors si même visiteur vu plusieurs fois)
  views      Int      @default(0)

  @@unique([date, type, path])
  @@index([type, date])
  @@index([date])
}
