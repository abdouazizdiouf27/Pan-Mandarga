# PAN Mandarga — production Hostinger (Node.js Web App)
#
# NE COMMITTEZ JAMAIS vos vrais secrets dans Git/ZIP.
# Sur Hostinger, renseignez ces variables dans hPanel > votre app Node.js > Environment Variables.

# MySQL Hostinger — à remplacer par les valeurs fournies par hPanel
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME

# Stockage persistant des médias : HORS du répertoire de build hbuilds/current.
# Exemple : /home/USERNAME/domains/panmandarga.sn/storage/uploads
UPLOADS_DIR=/home/USERNAME/domains/YOUR_DOMAIN/storage/uploads

# URL publique exacte (sans slash final)
NEXTAUTH_URL=https://YOUR_DOMAIN

# Secret aléatoire fort, différent de toute valeur de développement
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET

# Autorise NextAuth derrière le reverse proxy géré par Hostinger
AUTH_TRUST_HOST=true

# Bootstrap initial de l'admin.
# Générer un token long et aléatoire, l'utiliser UNE FOIS sur /admin/setup,
# puis supprimer BOOTSTRAP_TOKEN des variables d'environnement après création du compte.
BOOTSTRAP_TOKEN=CHANGE_ME_ONE_TIME_BOOTSTRAP_TOKEN

# Facultatif : script CLI local / maintenance avancée
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=
ADMIN_NAME=PAN Mandarga Admin
